# cp .env.example .env 후 서버에서만 채운다. .env 는 커밋하지 않는다(.gitignore).
# 이 파일은 compose 변수(DOMAIN, MYSQL_ROOT_PASSWORD)와 백엔드 환경변수(env_file)를 함께 담는다.

# 운영 도메인(예: camgong.example.com). localhost 면 Caddy 내부 인증서로 뜬다.
DOMAIN=
MYSQL_ROOT_PASSWORD=

# 백엔드. useAffectedRows=true 는 빼면 안 된다(기동 시 DatabaseSettingsCheck 가 검사).
DB_URL=jdbc:mysql://mysql:3306/camgong?useAffectedRows=true
DB_USER=
DB_PASSWORD=

# ALLOWED_ORIGINS, VERIFY_LINK_BASE_URL 은 compose.yaml 이 DOMAIN 으로 만든다. 여기 적어도 무시된다.
# ac.kr 메일은 따로 적지 않아도 가입된다. ac.kr 밖 대학(예: skku.edu)이나 여러 도메인을 한 학교로 묶을 때만 쓴다.
# 형식은 키=도메인,도메인;키=도메인(키는 학교 키, 한 번 쓰면 바꾸지 않는다). 예: skku.edu=skku.edu,g.skku.edu;sogang.ac.kr=sogang.ac.kr,sg.ac.kr
EXTRA_SCHOOL_DOMAINS=

# 탈퇴 장부를 둘 호스트 디렉터리(절대 경로, 예: /srv/camgong/ledger). 비우면 compose 가 뜨지 않는다.
# 먼저 만들고 앱 uid 에 넘긴다: mkdir -p /srv/camgong/ledger && sudo chown 10001 /srv/camgong/ledger
# 백엔드 안의 경로(WITHDRAW_LEDGER)는 compose.yaml 이 정한다. 여기 적어도 무시된다.
WITHDRAW_LEDGER_DIR=

# 백업 결과 알림(healthchecks.io 확인 주소, 예: https://hc-ping.com/<uuid>). deploy/backup.sh 가 이 파일에서 읽는다.
# 비우면 알리지 않고 경고만 낸다. 주소가 곧 비밀이라 저장소에 넣지 않는다.
HC_PING_URL=

# Gmail SMTP(587 STARTTLS). USERNAME 이 보내는 주소다. PASSWORD 는 앱 비밀번호.
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_REQUIRED=true
