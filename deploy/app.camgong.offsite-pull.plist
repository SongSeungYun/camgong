<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  서버 밖 백업(014) 예시. /Users/USER 를 맥 홈 경로로 바꿔 ~/Library/LaunchAgents/ 에 둔다.
  매일 05:00(서버 backup.sh 04:00 뒤)에 돈다. 그 시각에 맥이 자고 있으면 깨어날 때 돌고, 꺼져 있던 날은 건너뛴다.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>app.camgong.offsite-pull</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/USER/.local/bin/camgong-offsite-pull.sh</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>5</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>/Users/USER/Library/Logs/camgong-offsite-pull.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/USER/Library/Logs/camgong-offsite-pull.log</string>
</dict>
</plist>
